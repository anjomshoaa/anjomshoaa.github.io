---
import { Image } from 'astro:assets';

const {project} = Astro.props;
const {name, type, full_name, years, summary, featuredImage, heroImage, tags} = project.data;

// const { Content } = await render(project);

---


<div class="card card-side bg-base-300 shadow-sm">
  <figure>
	<Image width="300" src={featuredImage} alt={`Featured image for project ${name}`}/>
  </figure>

  <div class="card-body">
	<h2 class="card-title m-0 text-xl">
		{name}
	</h2>
	<p class="text-base m-0">
		<span class="italic">{type}</span> • {full_name}
	</p>
	<p class="text-base m-0">
		<span class="font-semibold">Years:</span> {years}
	</p>
	<p class="text-base mt-2">
		{summary}
	</p>

    <div class="card-actions justify-end">
      <a href={`/projects/${project.id}`}  class="btn btn-primary">View Details</a>
    </div>
  </div>
</div>

