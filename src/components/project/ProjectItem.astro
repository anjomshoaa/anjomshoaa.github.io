---
import { highlightAuthor } from "@/lib/utils";
import {render} from 'astro:content'

const {project} = Astro.props;
const {name, type, full_name, years, summary, featuredImage, heroImage, tags} = project.data;

// const { Content } = await render(project);

---


<div class="card bg-base-200">
	<div class="card-body p-3">

		<h2 class="card-title m-0 text-xl">
		{name}
		</h2>
		<p class="text-base m-0">
		<span class="italic">{type}</span> • {full_name}
		</p>
		<p class="text-base m-0">
		<span class="font-semibold">Years:</span> {years}
		</p>
		<p class="text-base mt-2">
		{summary}
		</p>

		<div class="flex space-x-2 justify-end m-0">

				<div class="card-actions">
					<a href={`/projects/${project.id}`} class="btn btn-sm btn-secondary ">
					View Details
					</a>
				</div>
		</div>
	</div>
</div>
